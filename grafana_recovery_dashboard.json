          },
          "editorMode": "code",
          "expr": "resilience4j_circuitbreaker_recovery_traffic_percentage{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"} > 0",
          "format": "time_series",
          "instant": false,
          "range": true,
