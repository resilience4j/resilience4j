{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping Resilience4j Micrometer metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "uid": "r4j-gradual-recovery",
  "title": "Resilience4j — Standard and gradual recovery",
  "description": "Optional gradual recovery shown alongside the existing public states. Select one breaker instance.",
  "tags": [
    "resilience4j",
    "circuitbreaker",
    "gradual-recovery"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "description": "One Prometheus scrape job.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(resilience4j_circuitbreaker_state, job)",
        "query": {
          "qryType": 1,
          "query": "label_values(resilience4j_circuitbreaker_state, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "description": "One scrape instance; no implicit fleet aggregation.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(resilience4j_circuitbreaker_state{job=\"${job}\"}, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(resilience4j_circuitbreaker_state{job=\"${job}\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "circuitbreaker",
        "label": "Circuit breaker",
        "description": "One circuit breaker name on the chosen instance.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(resilience4j_circuitbreaker_state{job=\"${job}\",instance=\"${instance}\"}, name)",
        "query": {
          "qryType": 1,
          "query": "label_values(resilience4j_circuitbreaker_state{job=\"${job}\",instance=\"${instance}\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {},
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Public state",
      "description": "The active standard Resilience4j state. Gradual recovery continues to report half_open.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "none",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "closed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "open"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "half_open"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "disabled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "forced_open"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "metrics_only"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (state) (resilience4j_circuitbreaker_state{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"} == 1)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Recovery policy",
      "description": "Presence of the optional recovery phase metric identifies a configured Gradual policy, even when inactive. Missing state data remains No data.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Standard",
                  "index": 0
                },
                "1": {
                  "text": "Gradual",
                  "index": 1
                }
              }
            }
          ],
          "unit": "none",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(count by (job, instance, name) (resilience4j_circuitbreaker_recovery_phase{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}) > bool 0) or on (job, instance, name) (0 * max by (job, instance, name) (resilience4j_circuitbreaker_state{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}))",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "Policy",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Recovery phase",
      "description": "One-based phase index. Zero means recovery is inactive. Ordinary breakers do not export this metric.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Inactive",
                  "index": 0
                }
              }
            }
          ],
          "unit": "none",
          "decimals": 0,
          "noValue": "Not enabled"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "resilience4j_circuitbreaker_recovery_phase{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "Phase",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recovery target",
      "description": "Configured admission target while recovering, not an observed rate. Zero means inactive, even in CLOSED.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Inactive",
                  "index": 0
                }
              }
            }
          ],
          "unit": "percent",
          "decimals": 0,
          "noValue": "Not enabled"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "resilience4j_circuitbreaker_recovery_traffic_percentage{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "Target",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Observed admission",
      "description": "Percentage over $__rate_interval from offered/permitted admission counters. No attempts means no observed percentage. Ordinary breakers do not export these counters.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "12.0.0",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "unit": "percent",
          "decimals": 1,
          "noValue": "No attempts / unavailable"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(100 * rate(resilience4j_circuitbreaker_admission_permitted_attempts_total{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}[$__rate_interval]) / rate(resilience4j_circuitbreaker_admission_attempts_total{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}[$__rate_interval])) and (rate(resilience4j_circuitbreaker_admission_attempts_total{job=\"${job}\",instance=\"${instance}\",name=\"${circuitbreaker}\"}[$__rate_interval]) > 0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "Observed",
          "refId": "A"
        }
      ]
    },
    {
