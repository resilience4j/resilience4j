    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Target is shown only while active. Observed admission spans the rate window and can include earlier phases or states; it is not a backend success rate. No zero-denominator substitution or hard clipping.",
      "fieldConfig": {
